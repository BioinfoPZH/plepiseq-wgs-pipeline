# KMA 
# Pinned in version 1.8.0
RUN git clone https://bitbucket.org/genomicepidemiology/kma.git; cd kma; git reset --hard 9b4f34be62b3445b13726f0be51faab6f9d78fe2; make; cd /opt/docker

### Most are just python scripts
ENV VIRULENCEFINDER_VERSION=2.0.5

### Plasmidfinder version is pinned to commit from 	2023-08-16, must be updated eventually
	
RUN git clone https://bitbucket.org/genomicepidemiology/plasmidfinder.git; cd plasmidfinder; git reset --hard 113df12; cd /opt/docker; \
    git clone https://bitbucket.org/genomicepidemiology/speciesfinder.git; cd speciesfinder; git reset --hard fdc37dade40bc6891afd7884ebf6e08aeecda494; python -m pip install --no-cache-dir . ; cd /opt/docker; \
    git clone https://bitbucket.org/genomicepidemiology/spifinder.git; cd spifinder; git reset --hard b11a075691009fe865eb25e19a89f921df1157f0; cd /opt/docker; \
    git clone https://bitbucket.org/genomicepidemiology/cgmlstfinder.git; cd cgmlstfinder; git reset --hard 18b27a0008bdd3710a344b3d3559559c2dd76917; cd /opt/docker; \
    git clone https://bitbucket.org/genomicepidemiology/mlst.git; cd mlst; git reset --hard bb8f0197bb9094a8ce00e338cb3cc59289764c8c; cd /opt/docker; \
    pip install resfinder==4.7.0 ;\
    git clone https://bitbucket.org/genomicepidemiology/virulencefinder.git; cd virulencefinder; git checkout tags/${VIRULENCEFINDER_VERSION} ;\
