ARG PIP_TIMEOUT=30
ARG PIP_INDEX_URL=https://pypi.org/simple
ARG PIP_TRUSTED_HOST
# Liczba watkow uzywana przez "make -j" / "spades_compile.sh -j" we wszystkich
# regulach RUN. Override przy buildzie: docker build --build-arg NPROC=8 ...
# Uwaga: Prodigal i Flye sa celowo budowane szeregowo (patrz komentarze nizej).
ARG NPROC=20

FROM nvidia/cuda:12.1.0-cudnn8-runtime-ubuntu22.04
LABEL maintainer="Michal Lazniewski <mlazniewski@pzh.gov.pl>"

ARG PIP_TIMEOUT
ARG PIP_INDEX_URL
ARG PIP_TRUSTED_HOST
ARG NPROC

ENV DEBIAN_FRONTEND=noninteractive
ENV LANG=C.UTF-8 LC_ALL=C.UTF-8

RUN apt-get update --fix-missing && apt upgrade -y && \
    apt-get install build-essential pkgconf python3.10 python3-pip default-jre curl unzip wget vim bc htop git gcc zlib1g-dev libbz2-dev libcurl4-gnutls-dev libssl-dev liblzma-dev python3-pycurl screen iqtree mash seqtk -y


RUN pip install ete3 numba numpy==1.23.4 biopython==1.83 psutil pysam 'cgecore>=1.5.5,<2.0' packaging tables==3.8.0 h5py xlrd scikit-learn fiona==1.9.6 geodatasets geopandas plotly
### xlrd - allows to read excels, need that for VFDB
### Not sure why I choose these version of some libraries

WORKDIR /usr/bin
RUN ln -s python3 python

RUN mkdir -p /opt/docker
WORKDIR /opt/docker

RUN wget https://www.drive5.com/downloads/usearch11.0.667_i86linux32.gz ;\
    gunzip usearch11.0.667_i86linux32.gz ;\
    chmod a+x usearch11.0.667_i86linux32


# EToKI

### Szczatkowo, ale ciagle z niego korzystamy
RUN git clone https://github.com/zheminzhou/EToKi.git
WORKDIR /opt/docker/EToKi

### nie sciagamy kraken-a tutaj ale w wersji finalnej bez tego sie nie obejdzie 
### sciaganie bazy kraken-owej opisane jest w /home/michall/kraken2/README_KRAKEN_INSTALL
### tutaj tworzymy tylko katalog i podczas konfigurowania Etoki mowimy mu aby tam zagladal w trakcie pracy
### przy starcie kontenera po prostu mapujemy baze z dysku na kontener przez "-v"
### baza krakenowa wazy 240 Gb  
### usearch must be manually copied to /opt/docker/EToKi/externals,  "--usearch" option seems not to work as expected
### f070664 latest commit as of 02.2026 (repo was not updated since 2024)

RUN git reset --hard f070664; \
    mkdir -p /kraken2_sdb; \
    sed -i "s|https://netcologne.dl.sourceforge.net/project/bbmap/BBMap_38.90.tar.gz|https://sourceforge.net/projects/bbmap/files/BBMap_38.90.tar.gz/download|g" modules/configure.py

    RUN python EToKi.py configure --install --usearch /opt/docker/usearch11.0.667_i86linux32 --link_krakenDB /kraken2_sdb/ --path iqtree=/usr/bin/iqtree2
RUN cp /opt/docker/usearch11.0.667_i86linux32 /opt/docker/EToKi/externals 

ENV PATH="/opt/docker/EToKi:/opt/docker/EToKi/externals/ncbi-blast-2.8.1+/bin:/opt/docker/EToKi/externals/:$PATH"

### Update spades to version 4.2 and link the binary to /opt/docker/EToKi/externals/spades
WORKDIR /opt/docker/
RUN git clone https://github.com/ablab/spades.git ;\
    cd /opt/docker/spades; \
    git reset --hard 874c54b; \
    ./spades_compile.sh -j ${NPROC};\
    rm -r build_spades; \
    ln -sfn /opt/docker/spades/bin/spades.py /opt/docker/EToKi/externals/spades.py ;\
    cd /opt/docker

## Updating pilon
RUN wget -O /opt/docker/EToKi/externals/pilon.jar https://github.com/broadinstitute/pilon/releases/download/v1.24/pilon-1.24.jar


# SeqSero2
# Pinned in version 1.8.0
WORKDIR /opt/docker
RUN git clone https://github.com/denglab/SeqSero2.git; cd /opt/docker/SeqSero2; git reset --hard ff1dce923159fe6a7a0ea2ff24cf1ddb2000071a; python3 -m pip install --user . ; cd /opt/docker

# MAFFT
RUN wget https://mafft.cbrc.jp/alignment/software/mafft-7.505-with-extensions-src.tgz ;\
    tar -zxf mafft-7.505-with-extensions-src.tgz; \
    cd /opt/docker/mafft-7.505-with-extensions/core ;\
    make; make install; \
    cd /opt/docker/mafft-7.505-with-extensions/extensions ;\
